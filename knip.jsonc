{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // App entry (src/main.ts) is auto-detected by knip's vite plugin from index.html +
  // vite.config.js, so it is not listed here (listing it triggers a "redundant entry" hint).
  // There is no test suite, so there are no test entry globs.
  "project": ["src/**/*.{ts,vue}"],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false,
  "rules": {
    // Warn mode: every rule is "warn" (reported, exit 0) or "off". Nothing gates CI here.
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "warn",
    "exports": "warn",
    "types": "warn",
    "unresolved": "off",
    "binaries": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off",
  },
}
